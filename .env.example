# copy to .env (git-ignored) and adjust: `make env.init`
# read by the Makefile, docker compose, atlas.hcl and the go tests/seeder.
# plain KEY=value only: no quotes, no `export`, no inline comments (make takes
# them literally).

# local database credentials. they only seed a fresh volume, so after changing
# them run `make infra.reset`
DB_USER=user
DB_PASSWORD=passwd
DB_NAME=default

# target for `make migrate.* ATLAS_ENV=staging`, e.g.
# postgres://user:passwd@staging-host:5432/app?sslmode=require
STAGING_URL=
